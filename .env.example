# Core runtime
NODE_ENV=development
STALLONE_NAME=Stallone
STALLONE_WORKSPACE_ROOT=/Users/aritrarpal/Documents/workspace_biz
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/localclaw
DATABASE_SCHEMA=stallone

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub
GITHUB_PAT=
GITHUB_USERNAME=
GITHUB_REPO_OWNER=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REPO_VISIBILITY=private
GITHUB_AUTO_PUBLISH=false
GIT_DEFAULT_BRANCH=main

# Railway
RAILWAY_API_TOKEN=
RAILWAY_GRAPHQL_ENDPOINT=https://backboard.railway.com/graphql/v2
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_DEPLOY_ENABLED=false
RAILWAY_DEPLOY_POLL_INTERVAL_MS=10000
RAILWAY_DEPLOY_TIMEOUT_MS=900000

# Gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_ESCALATION_MODEL=gemini-2.5-pro
GEMINI_TASK_TOKEN_BUDGET=50000

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30s
OLLAMA_REQUEST_TIMEOUT_MS=120000
OLLAMA_WARMUP_ENABLED=false
OLLAMA_WARMUP_TIMEOUT_MS=180000
OLLAMA_MAX_RETRIES=3
OLLAMA_MODEL_CODER=qwen2.5-coder:7b
OLLAMA_MODEL_ROUTER=llama3.2:3b
OLLAMA_MODEL_VERIFIER=qwen2.5-coder:7b
OLLAMA_MODEL_EMBED=nomic-embed-text:latest

# Execution controls
TASK_POLL_INTERVAL_MS=30000
TASK_TIMEOUT_HOURS=4
MAX_CONSECUTIVE_FAILURES=3
DOCKER_SANDBOX_ENABLED=false
REPAIR_AUTO_APPROVE=true
DEPLOY_AUTO_APPROVE=false
HEARTBEAT_INTERVAL_MS=3600000
SOUL_EVOLUTION_ENABLED=true

# Skills
SKILLS_BUILTIN_DIR=skills/builtin
SKILLS_ALLOW_GENERATED=true
SKILLS_AUTO_GENERATE=true
SKILLS_AUTO_GENERATE_MIN_PATTERN_COUNT=3
SKILLS_AUTO_GENERATE_MIN_SUCCESSES=2

# Memory retention
MEMORY_RETENTION_ACTIVE_DAYS=14
MEMORY_RETENTION_ARCHIVED_DAYS=3
MEMORY_RETENTION_ORPHAN_DAYS=7
MEMORY_RETENTION_INTERVAL_MS=7200000
MEMORY_RETENTION_MAX_PRUNE=200

# Presence / online detection
PRESENCE_ONLINE_THRESHOLD=0.5
PRESENCE_WINDOW_MINUTES=30

# Control API
CONTROL_API_ENABLED=true
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=4173

# Operator UX
UI_ENABLED=true
UI_DIST_DIR=web/dist
UI_DEV_ORIGIN=http://127.0.0.1:5173
